# -----------------------------------------------------------------------
# Sign Language Interpreter - Environment Configuration Example
# Copy this file to ".env" and adjust values as needed.
# Do NOT commit a real ".env" file with secrets to version control.
# -----------------------------------------------------------------------

# --- Camera settings ---
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_MIRROR=true

# --- MediaPipe Hands settings ---
MP_MAX_NUM_HANDS=1
MP_MIN_DETECTION_CONFIDENCE=0.6
MP_MIN_TRACKING_CONFIDENCE=0.5
MP_MODEL_COMPLEXITY=1
HAND_LANDMARKER_MODEL_PATH=backend/hand_detection/models/hand_landmarker.task

# --- Model settings ---
MODEL_PATH=
MODEL_CONFIDENCE_THRESHOLD=0.5

# --- Application / debug settings ---
DEBUG=false
LOG_LEVEL=INFO

# --- API settings ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Pipeline settings ---
PIPELINE_TARGET_FPS=30
