# -----------------------------------------------------------------------
# Sign Language Interpreter - Environment Configuration Example
# Copy this file to ".env" and adjust values as needed.
# Do NOT commit a real ".env" file with secrets to version control.
# -----------------------------------------------------------------------

# --- Camera settings ---
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_MIRROR=true

# --- MediaPipe Hands settings ---
MP_MAX_NUM_HANDS=1
MP_MIN_DETECTION_CONFIDENCE=0.6
MP_MIN_TRACKING_CONFIDENCE=0.5
MP_MODEL_COMPLEXITY=1
HAND_LANDMARKER_MODEL_PATH=backend/hand_detection/models/hand_landmarker.task

# --- Model settings ---
# Path to the trained ONNX model (generated by scripts/train_model.py)
MODEL_ONNX_PATH=backend/model/sign_model.onnx
# Path to the JSON label list (generated by scripts/train_model.py)
MODEL_LABELS_PATH=backend/model/labels.json
# Minimum confidence to display a prediction (0.0 – 1.0)
MODEL_CONFIDENCE_THRESHOLD=0.6
# Set to false to force MockSignLanguageModel even if ONNX file exists
USE_REAL_MODEL=true

# --- Application / debug settings ---
DEBUG=false
LOG_LEVEL=INFO

# --- API settings ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Pipeline settings ---
PIPELINE_TARGET_FPS=30
